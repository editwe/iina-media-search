{
  "name": "Media Search",
  "identifier": "com.example.iina-media-search",
  "version": "1.4.0",
  "description": "Search the file you're playing on Douban / IMDb / TMDB — or any site you add. Custom engines, recordable hotkeys, copy filename without extension.",
  "localized": {
    "zh-Hans": {
      "name": "Media Search",
      "description": "播放时一键搜索当前文件：豆瓣 / IMDb / TMDB 或你添加的任意站点。支持自定义引擎、按键录入热键、复制不带扩展名的文件名。",
      "sidebarTab": {
        "name": "Media Search"
      }
    },
    "en": {
      "name": "Media Search",
      "description": "Search the file you're playing on Douban / IMDb / TMDB — or any site you add. Custom engines, recordable hotkeys, copy filename without extension.",
      "sidebarTab": {
        "name": "Media Search"
      }
    }
  },
  "author": {
    "name": "editwe",
    "url": "https://github.com/editwe"
  },
  "entry": "index.js",
  "permissions": [
    "show-osd",
    "file-system"
  ],
  "sidebarTab": {
    "name": "Media Search"
  },
  "preferencesPage": "pref.html",
  "preferenceDefaults": {
    "cleanName": true,
    "keepEpisode": true,
    "showOSD": true,
    "copyTarget": "filename",
    "copyKey": "Alt+c",
    "engines": "[{\"id\":\"douban\",\"name\":\"Douban\",\"tpl\":\"https://search.douban.com/movie/subject_search?search_text={q}\",\"key\":\"Alt+1\"},{\"id\":\"imdb\",\"name\":\"IMDb\",\"tpl\":\"https://www.imdb.com/find/?q={q}&s=tt\",\"key\":\"Alt+2\"},{\"id\":\"tmdb\",\"name\":\"TMDB\",\"tpl\":\"https://www.themoviedb.org/search?query={q}&language=zh-CN\",\"key\":\"Alt+3\"},{\"id\":\"google\",\"name\":\"Google\",\"tpl\":\"https://www.google.com/search?q={q}\",\"key\":\"Alt+4\"},{\"id\":\"bing\",\"name\":\"Bing\",\"tpl\":\"https://www.bing.com/search?q={q}\",\"key\":\"Alt+5\"}]"
  },
  "ghRepo": "editwe/iina-media-search",
  "ghVersion": 2,
  "homepage": "https://github.com/editwe/iina-media-search"
}
