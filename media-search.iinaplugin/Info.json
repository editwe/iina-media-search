{
  "name": "Media Search",
  "identifier": "com.example.iina-media-search",
  "version": "1.3.1",
  "description": "Search the currently playing file on Douban / IMDb / TMDB — or any site you add. Custom engines, recordable hotkeys, copy filename without extension. 播放时一键搜索当前文件，支持自定义引擎与按键录入热键。 https://github.com/editwe/iina-media-search",
  "author": {
    "name": "editwe",
    "url": "https://github.com/editwe"
  },
  "entry": "index.js",
  "permissions": [
    "show-osd",
    "file-system"
  ],
  "sidebarTab": {
    "name": "Media Search"
  },
  "preferencesPage": "pref.html",
  "preferenceDefaults": {
    "cleanName": true,
    "keepEpisode": true,
    "showOSD": true,
    "copyTarget": "filename",
    "copyKey": "Alt+c",
    "engines": "[{\"id\":\"douban\",\"name\":\"豆瓣\",\"tpl\":\"https://search.douban.com/movie/subject_search?search_text={q}\",\"key\":\"Alt+1\"},{\"id\":\"imdb\",\"name\":\"IMDb\",\"tpl\":\"https://www.imdb.com/find/?q={q}&s=tt\",\"key\":\"Alt+2\"},{\"id\":\"tmdb\",\"name\":\"TMDB\",\"tpl\":\"https://www.themoviedb.org/search?query={q}&language=zh-CN\",\"key\":\"Alt+3\"},{\"id\":\"google\",\"name\":\"Google\",\"tpl\":\"https://www.google.com/search?q={q}\",\"key\":\"Alt+4\"},{\"id\":\"bing\",\"name\":\"必应\",\"tpl\":\"https://www.bing.com/search?q={q}\",\"key\":\"Alt+5\"}]"
  },
  "homepage": "https://github.com/editwe/iina-media-search"
}
